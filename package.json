{
    "name": "carta-frontend",
    "version": "6.0.0-dev",
    "repository": "https://github.com/CARTAvis/carta-frontend",
    "description": "The browser-based frontend component of CARTA, a radio-astronomy visualization tool designed for the ALMA, the VLA and the SKA pathfinders.",
    "homepage": "./",
    "devDependencies": {
        "@babel/plugin-proposal-decorators": "^7.28.0",
        "@babel/preset-env": "^7.28.3",
        "@babel/preset-react": "^7.27.1",
        "@babel/preset-typescript": "^7.27.1",
        "@blueprintjs/eslint-plugin": "^5.0.0",
        "@blueprintjs/tslint-config": "^4.1.6",
        "@blueprintjs/core": "^5.11.0",
        "@blueprintjs/icons": "^5.7.1",
        "@blueprintjs/select": "^5.2.2",
        "@blueprintjs/table": "^5.1.8",
        "@jest/types": "^30.0.5",
        "@rsbuild/core": "^1.7.3",
        "@rsbuild/plugin-node-polyfill": "^1.4.4",
        "@rsbuild/plugin-react": "^1.4.5",
        "@rsbuild/plugin-sass": "^1.5.0",
        "@rsbuild/plugin-eslint": "^1.2.1",
        "@testing-library/jest-dom": "^6.4.8",
        "@testing-library/react": "^16.0.1",
        "@testing-library/user-event": "^14.5.2",
        "@types/jest": "^29.5.12",
        "@types/jquery": "^3.5.30",
        "@types/lodash": "^4.17.7",
        "@types/node": "^20.14.13",
        "@types/plotly.js": "^2.33.3",
        "@types/prismjs": "^1.26.4",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@types/react-plotly.js": "^2.6.3",
        "@types/react-window": "^1.8.8",
        "@types/tinycolor2": "^1.4.6",
        "@typescript-eslint/eslint-plugin": "^8.46.0",
        "@typescript-eslint/parser": "^8.46.0",
        "ajv": "^8.17.1",
        "assert": "^2.1.0",
        "axios": "^1.12.2",
        "babel-jest": "^30.2.0",
        "buffer": "^6.0.3",
        "chart.js": "^4.5.0",
        "classnames": "^2.5.1",
        "constants-browserify": "^1.0.0",
        "crypto-browserify": "^3.12.0",
        "eslint": "^9.37.0",
        "eslint-plugin-import": "^2.26.0",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-tsdoc": "^0.4.0",
        "fuzzy-search": "^3.2.1",
        "glob-to-regexp": "^0.4.1",
        "golden-layout": "^1.5.9",
        "html2canvas": "^1.4.1",
        "idb": "^8.0.3",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^30.2.0",
        "jest-canvas-mock": "^2.5.2",
        "jest-environment-jsdom": "^30.2.0",
        "jest-transform-stub": "^2.0.0",
        "jwt-decode": "^4.0.0",
        "konva": "^9.3.16",
        "lodash": "^4.17.15",
        "mnemonist": "^0.40.3",
        "mobx": "^6.15.0",
        "mobx-react": "^9.2.1",
        "moment": "^2.30.1",
        "npm-run-all": "^4.1.3",
        "os-browserify": "^0.3.0",
        "path-browserify": "^1.0.1",
        "plotly.js": "^3.1.1",
        "prettier": "3.6.2",
        "preval.macro": "^5.0.0",
        "prismjs": "^1.30.0",
        "protobufjs": "^7.5.4",
        "protobufjs-cli": "1.1.3",
        "raw-loader": "^4.0.2",
        "react": "^18.3.1",
        "react-chartjs-2": "^5.3.0",
        "react-color": "^2.17.3",
        "react-dom": "^18.3.1",
        "react-iframe": "^1.8.5",
        "react-konva": "^18.2.10",
        "react-plotly.js": "^2.6.0",
        "react-refresh": "^0.18.0",
        "react-rnd": "^10.5.2",
        "react-scroll-to-bottom": "^4.2.0",
        "react-simple-code-editor": "^0.14.1",
        "react-split-pane": "^0.1.91",
        "react-window": "^2.2.0",
        "rsbuild-plugin-glsl": "^1.0.1",
        "rxjs": "^7.8.2",
        "semver": "^7.7.3",
        "source-map-explorer": "^2.5.3",
        "stats-js": "^1.0.1",
        "stream-browserify": "^3.0.0",
        "tinycolor2": "^1.6.0",
        "ts-jest": "^29.4.4",
        "typescript": "^5.9.3",
        "util": "^0.12.5",
        "uuid": "^13.0.0",
        "worker-loader": "^3.0.8",
        "worker-rspack-loader": "^3.1.2"
    },
    "scripts": {
        "git-info": "./git-info.sh",
        "analyze": "source-map-explorer build/static/js/main.*",
        "postinstall": "patch-package",
        "start": "npm run git-info; rsbuild dev",
        "build": "npm run git-info; npm-run-all build-wrappers build-protobuf link-schemas build-ts",
        "build-docker": "npm run git-info; npm-run-all build-wrappers-docker build-protobuf link-schemas build-ts",
        "build-singularity": "npm run git-info; npm-run-all build-wrappers-singularity build-protobuf link-schemas build-ts",
        "build-ts": "rsbuild build",
        "preview": "rsbuild preview",
        "build-libs": "./wasm_libs/build_libs.sh",
        "build-libs-docker": "./build_wasm_libs_docker.sh",
        "build-libs-singularity": "./build_wasm_libs_singularity.sh",
        "build-wrappers": "./wasm_src/build_wrappers.sh",
        "build-wrappers-docker": "./build_wasm_wrappers_docker.sh",
        "build-wrappers-singularity": "./build_wasm_wrappers_singularity.sh",
        "build-protobuf": "./protobuf/build_proto.sh",
        "link-schemas": "./schemas/link_schemas.sh",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "reformat": "npx prettier --write ./src",
        "checkformat": "npx prettier --check ./src",
        "prepack": "npm run build-libs-docker; npm run build-docker",
        "fix-eslint": "eslint --fix ./src; npx prettier --write ./src",
        "check-eslint": "eslint ./src"
    },
    "eslintConfig": {
        "parser": "@typescript-eslint/parser",
        "plugins": [
            "import",
            "@typescript-eslint",
            "simple-import-sort",
            "eslint-plugin-tsdoc",
            "@blueprintjs"
        ],
        "rules": {
            "@typescript-eslint/no-unused-expressions": "error",
            "@typescript-eslint/consistent-type-imports": [
                "error",
                {
                    "fixStyle": "inline-type-imports"
                }
            ],
            "import/no-webpack-loader-syntax": "off",
            "no-unused-expressions": "off",
            "no-unused-vars": "off",
            "@typescript-eslint/no-explicit-any": "off",
            "@typescript-eslint/no-unused-vars": [
                "error",
                {
                    "args": "none"
                }
            ],
            "object-curly-spacing": "off",
            "jsx-a11y/alt-text": "off",
            "simple-import-sort/imports": "error",
            "simple-import-sort/exports": "error",
            "import/newline-after-import": "error",
            "import/no-duplicates": "error",
            "tsdoc/syntax": "error",
            "prefer-const": "error",
            "@blueprintjs/classes-constants": "error",
            "@blueprintjs/html-components": "error"
        },
        "overrides": [
            {
                "files": [
                    "*.js",
                    "*.jsx",
                    "*.ts",
                    "*.tsx"
                ],
                "rules": {
                    "simple-import-sort/imports": [
                        "error",
                        {
                            "groups": [
                                [
                                    "^react",
                                    "^@?\\w"
                                ],
                                [
                                    "^(components|enums|icons|models|services|stores|utilities)(/.*|$)"
                                ],
                                [
                                    "^\\u0000"
                                ],
                                [
                                    "^\\.\\.(?!/?$)",
                                    "^\\.\\./?$"
                                ],
                                [
                                    "^\\./(?=.*/)(?!/?$)",
                                    "^\\.(?!/?$)",
                                    "^\\./?$"
                                ],
                                [
                                    "^.+\\.?(css)$"
                                ]
                            ]
                        }
                    ]
                }
            }
        ]
    },
    "browserslist": {
        "production": [
            "last 2 chrome versions",
            "last 2 firefox versions",
            "last 2 safari versions"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "dependencies": {
        "patch-package": "^8.0.1",
        "usehooks-ts": "^3.1.1"
    },
    "overrides": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "typescript": "^5.9.3",
        "fork-ts-checker-webpack-plugin": "^6.5.3",
        "@types/trusted-types": "^2.0.7"
    },
    "optionalDependencies": {
        "@rspack/binding-darwin-arm64": "^1.5.5",
        "@rspack/binding-darwin-x64": "^1.5.5",
        "@rspack/binding-linux-arm64-gnu": "^1.5.5",
        "@rspack/binding-linux-arm64-musl": "^1.5.5",
        "@rspack/binding-linux-x64-gnu": "^1.5.5",
        "@rspack/binding-linux-x64-musl": "^1.5.5",
        "sass-embedded-darwin-arm64": "^1.93.2",
        "sass-embedded-darwin-x64": "^1.93.2",
        "sass-embedded-linux-arm64": "^1.93.2",
        "sass-embedded-linux-musl-arm64": "^1.93.2",
        "sass-embedded-linux-musl-x64": "^1.93.2",
        "sass-embedded-linux-x64": "^1.93.2"
    }
}
