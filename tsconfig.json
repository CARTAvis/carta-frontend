{
  "compilerOptions": {
    "target": "es6",
    "paths": {
      "components": [
        "./src/components/index"
      ],
      "HotkeyWrapper": [
        "./src/HotkeyWrapper"
      ],
      "components/*": [
        "./src/components/*"
      ],
      "enums": [
        "./src/enums/index"
      ],
      "enums/*": [
        "./src/enums/*"
      ],
      "icons": [
        "./src/icons/index"
      ],
      "icons/*": [
        "./src/icons/*"
      ],
      "models": [
        "./src/models/index"
      ],
      "models/*": [
        "./src/models/*"
      ],
      "services": [
        "./src/services/index"
      ],
      "services/*": [
        "./src/services/*"
      ],
      "stores": [
        "./src/stores/index"
      ],
      "stores/*": [
        "./src/stores/*"
      ],
      "static/*": [
        "./src/static/*"
      ],
      "utilities": [
        "./src/utilities/index"
      ],
      "utilities/*": [
        "./src/utilities/*"
      ]
    },
    "rootDir": "src",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src",
    "declarations.d.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "wasm_src",
    "wasm_libs",
    "protobuf",
    "scripts",
    "acceptance-tests",
    "webpack",
    "jest",
    "src/setupTests.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "emscripten.simg"
  ]
}
